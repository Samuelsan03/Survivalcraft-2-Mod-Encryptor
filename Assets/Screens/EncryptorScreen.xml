<Screen xmlns="runtime-namespace:Game">

  <PanoramaWidget />

  <StackPanelWidget Direction="Horizontal">

    <CanvasWidget Style="{Widgets/TopBarContents}">
      <LabelWidget Name="TopBar.Label" Text="[EncryptorScreen:1]" />
    </CanvasWidget>

    <StackPanelWidget Direction="Vertical" VerticalAlignment="Center">

      <CanvasWidget Size="0, 8"/>

      <StackPanelWidget Direction="Horizontal" Margin="10, 0">
        <CanvasWidget Size="10, 0"/>
        <LabelWidget Name="PathLabel" Text="Mods" VerticalAlignment="Center" Color="200, 200, 50"/>
        <CanvasWidget Size="Infinity, 0"/>
        <LabelWidget Name="InfoLabel" Text="[EncryptorScreen:2]" VerticalAlignment="Center" Color="128, 128, 128"/>
      </StackPanelWidget>

      <CanvasWidget Size="0, 8"/>

      <CanvasWidget Margin="10, 0">
        <BevelledRectangleWidget Style="{Styles/Area}" />
        <ListPanelWidget Name="DirectoryList" Direction="Vertical" Margin="3, 3" ItemSize="48" SelectionColor="10, 70, 0, 90"/>
      </CanvasWidget>

      <CanvasWidget Size="0, 8"/>

      <StackPanelWidget Direction="Horizontal" Margin="10, 0">
        <BevelledButtonWidget Name="UpDirectory" Style="{Styles/ButtonStyle_UpDirectory}"/>
        <CanvasWidget Size="10, 0"/>
        <BevelledButtonWidget Name="EncryptButton" Style="{Styles/ButtonStyle_310x60}" Text="[EncryptorScreen:9]" IsEnabled="false"/>
        <CanvasWidget Size="Infinity, 0"/>
      </StackPanelWidget>

      <CanvasWidget Size="0, 8"/>

    </StackPanelWidget>
    
  </StackPanelWidget>

</Screen>
